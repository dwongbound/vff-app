{
  "name": "vff-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "dotenv -e env/dev.env -- next dev",
    "build": "prisma generate && next build",
    "vercel-build": "sh scripts/vercel-build.sh",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e env/dev.env -- prisma db push",
    "db:migrate": "dotenv -e env/dev.env -- prisma migrate dev",
    "db:migrate:deploy:prod": "prisma migrate deploy",
    "db:seed": "dotenv -e env/dev.env -- prisma db seed",
    "db:studio": "dotenv -e env/dev.env -- prisma studio",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "dotenv -e env/test.env -- playwright test",
    "e2e:server": "E2E=1 dotenv -e env/test.env -- next dev -p 3100"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.25",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true
  }
}
