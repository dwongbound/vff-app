# ── Production environment ──────────────────────────────────────────────
# Copy to env/prod.env (gitignored) and fill in real secrets.

POSTGRES_USER=vff
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vff_prod

# Inside compose the db is reachable at its service name.
DATABASE_URL=postgresql://vff:CHANGE_ME@db-prod:5432/vff_prod

NEXTAUTH_URL=https://your-domain.example
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_TAIL_NUMBER=N172VF

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommended in prod: an S3-compatible bucket so photos survive redeploys.
STORAGE_DRIVER=s3
S3_BUCKET=vff-photos
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

APP_TZ=America/Los_Angeles
