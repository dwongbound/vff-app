# ── Development environment ─────────────────────────────────────────────
# Copy this file to env/dev.env (that folder is gitignored) and fill it in.

# Consumed by the postgres container in docker-compose.yml
POSTGRES_USER=vff
POSTGRES_PASSWORD=vff
POSTGRES_DB=vff_dev

# Points at localhost for running `npm run dev` on your host against the
# dockerized db. When the app itself runs inside compose, the compose file
# overrides the host to `db-dev`.
DATABASE_URL=postgresql://vff:vff@localhost:5432/vff_dev

NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-dev

# Seed logins (prisma/seed.ts): the admin account you sign in with, plus the
# password shared by every seeded demo member.
SEED_ADMIN_EMAIL=admin@vffclub.test
SEED_ADMIN_PASSWORD=flyvff123

# The club's aircraft, seeded on first `db:seed`. Change to your real N-number.
SEED_TAIL_NUMBER=N172VF

# Google SSO (optional). Set BOTH to enable "Continue with Google". Redirect
# URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Photo storage ───────────────────────────────────────────────────────
# "local" writes to ./storage/photos (fine for dev; needs a persistent volume
# in prod). "s3" talks to any S3-compatible bucket — Cloudflare R2, AWS S3,
# Backblaze B2, MinIO. See README "Photo storage".
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/photos

# Only needed when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=auto
# R2: https://<accountid>.r2.cloudflarestorage.com   AWS: leave blank
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and some self-hosted gateways need path-style addressing.
S3_FORCE_PATH_STYLE=false

# Timezone reservations and flight dates are interpreted in. Named APP_TZ
# because Vercel reserves TZ; instrumentation.ts copies it into process.env.TZ
# at server startup.
APP_TZ=America/Los_Angeles
