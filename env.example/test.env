# ── Test environment (vitest + playwright e2e) ──────────────────────────
# Copy to env/test.env. Separate db on port 5433 so e2e runs never touch your
# dev data.

POSTGRES_USER=vff
POSTGRES_PASSWORD=vff
POSTGRES_DB=vff_test

DATABASE_URL=postgresql://vff:vff@localhost:5433/vff_test

# e2e server runs on 3100 (see playwright.config.ts / e2e:server script)
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=test-secret-not-a-real-one

# Seed logins — the e2e suite signs in as this admin with this password
# (tests/e2e/helpers.ts), so keep them in sync if you change them.
SEED_ADMIN_EMAIL=admin@vffclub.test
SEED_ADMIN_PASSWORD=flyvff123

# The club aircraft the e2e suite reserves and files flights against.
SEED_TAIL_NUMBER=N172VF

# Photos go to a throwaway directory during tests — never a real bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/test-photos

# See env/dev.env — APP_TZ instead of TZ (Vercel reserves TZ); the compose
# file still sets TZ directly on the containers themselves.
APP_TZ=America/Los_Angeles
